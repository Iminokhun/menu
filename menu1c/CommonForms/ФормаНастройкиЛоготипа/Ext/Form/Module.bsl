// --- 1. ЧТЕНИЕ ДАННЫХ ПРИ ОТКРЫТИИ ---

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// 1.1. Загружаем текстовые данные
	ИмяОрганизации = Константы.ИмяОрганизации.Получить();
	Слоган         = Константы.Слоган.Получить();
	НомерТелефона  = Константы.НомерТелефона.Получить();
	
	// 1.2. Загружаем Логотип (картинка)
	Лого = Константы.ЛоготипОрганизации.Получить();
	Если ТипЗнч(Лого) = Тип("ХранилищеЗначения") Тогда
		// Помещаем во временное хранилище, чтобы показать на форме
		КартинкаИзХранилища = Лого.Получить();
		Если КартинкаИзХранилища <> Неопределено Тогда
			АдресКартинки = ПоместитьВоВременноеХранилище(КартинкаИзХранилища, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	// 1.3. Загружаем QR-код (картинка)
	QR = Константы.QRИнстаграма.Получить();
	Если ТипЗнч(QR) = Тип("ХранилищеЗначения") Тогда
		КартинкаQR = QR.Получить();
		Если КартинкаQR <> Неопределено Тогда
			АдресQR = ПоместитьВоВременноеХранилище(КартинкаQR, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// --- 2. РАБОТА С ЛОГОТИПОМ ---

&НаКлиенте
Процедура ЗагрузитьЛоготип(Команда)
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьЛоготипЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЛоготипЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если Результат Тогда
		АдресКартинки = Адрес; // Обновляем картинку на форме
		СохранитьЛоготипНаСервере(Адрес); // Сразу сохраняем в базу
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьЛоготипНаСервере(Адрес)
	Двоичные = ПолучитьИзВременногоХранилища(Адрес);
	Константы.ЛоготипОрганизации.Установить(Новый ХранилищеЗначения(Двоичные));
КонецПроцедуры

// --- 3. РАБОТА С QR-КОДОМ ---

&НаКлиенте
Процедура ЗагрузитьQR(Команда)
	// Создайте кнопку на форме и привяжите к этой команде
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьQRЗавершение", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьQRЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если Результат Тогда
		АдресQR = Адрес; // Обновляем картинку на форме
		СохранитьQRНаСервере(Адрес); // Сразу сохраняем в базу
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьQRНаСервере(Адрес)
	Двоичные = ПолучитьИзВременногоХранилища(Адрес);
	Константы.QRИнстаграма.Установить(Новый ХранилищеЗначения(Двоичные));
КонецПроцедуры

// --- 4. СОХРАНЕНИЕ ТЕКСТОВЫХ ПОЛЕЙ ---

// Создайте кнопку "Сохранить данные" и привяжите к этой команде
&НаКлиенте
Процедура СохранитьДанные(Команда)
	СохранитьТекстовыеДанныеНаСервере();
	ПоказатьОповещениеПользователя("Успешно", , "Настройки организации сохранены!");
КонецПроцедуры

&НаСервере
Процедура СохранитьТекстовыеДанныеНаСервере()
	Константы.ИмяОрганизации.Установить(ИмяОрганизации);
	Константы.Слоган.Установить(Слоган);
	Константы.НомерТелефона.Установить(НомерТелефона);
КонецПроцедуры  


&НаКлиенте
Процедура ВыгрузитьИнфо(Команда)
	
	Состояние("Выгрузка настроек магазина...");
	
	// Сначала сохраняем то, что ввели на форме, чтобы улетело актуальное
	СохранитьТекстовыеДанныеНаСервере();
	
	// Отправляем в Firebase
	Ошибка = "";
	ВыгрузитьИнфоМагазинаНаСервере(Ошибка);
	
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Сообщить("Ошибка выгрузки настроек: " + Ошибка);
	Иначе
		Сообщить("✅ Настройки магазина (Лого, QR, Телефоны) успешно выгружены!");
	КонецЕсли;
	
	Состояние("Готово");

КонецПроцедуры

&НаСервере
Процедура ВыгрузитьИнфоМагазинаНаСервере(Ошибка)
	
	IDПроекта = "andalus-menu-63f23";
	Соединение = Новый HTTPСоединение("firestore.googleapis.com", 443, , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	// 1. Получаем картинки в Base64 из констант
	СтрокаЛого = ПолучитьBase64ИзКонстанты(Константы.ЛоготипОрганизации);
	СтрокаQR   = ПолучитьBase64ИзКонстанты(Константы.QRИнстаграма);
	
	// 2. Получаем тексты (читаем напрямую из констант, чтобы данные были свежими)
	ТекИмя     = Константы.ИмяОрганизации.Получить();
	ТекСлоган  = Константы.Слоган.Получить();
	ТекТелефон = Константы.НомерТелефона.Получить();
	
	// 3. Собираем JSON для Firestore
	// Коллекция: shop_info, Документ: info
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("name",        Новый Структура("stringValue", СокрЛП(ТекИмя)));
	СтруктураПолей.Вставить("slogan",      Новый Структура("stringValue", СокрЛП(ТекСлоган)));
	СтруктураПолей.Вставить("phone",       Новый Структура("stringValue", СокрЛП(ТекТелефон)));
	
	// Картинки
	СтруктураПолей.Вставить("logo_base64", Новый Структура("stringValue", СтрокаЛого));
	СтруктураПолей.Вставить("qr_base64",   Новый Структура("stringValue", СтрокаQR));

	JSONСтруктура = Новый Структура("fields", СтруктураПолей);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, JSONСтруктура);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// 4. Отправляем (PATCH создает документ если нет, или обновляет)
	АдресРесурса = "/v1/projects/" + IDПроекта + "/databases/(default)/documents/shop_info/main";
	
	ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса);
	ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("PATCH", ЗапросHTTP);
		Если Ответ.КодСостояния <> 200 Тогда
			Ошибка = "Код " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Вспомогательная функция для извлечения картинки из ХранилищаЗначения (Константы)
&НаСервере
Функция ПолучитьBase64ИзКонстанты(МенеджерКонстанты)
	
	Попытка
		Хранилище = МенеджерКонстанты.Получить();
		Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
			Возврат "";
		КонецЕсли;
		
		Двоичные = Хранилище.Получить();
		If Двоичные = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		// Используем твою функцию сжатия, которая уже есть в коде!
		Возврат ПолучитьСжатоеИзображениеBase64(Двоичные);
		
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции  



&НаСервере
Функция ПолучитьСжатоеИзображениеBase64(ИсходныеДанные)
	
	Попытка
		Двоичные = Неопределено;
		
		// 1. Извлекаем двоичные данные
		Если ТипЗнч(ИсходныеДанные) = Тип("ХранилищеЗначения") Тогда
			Двоичные = ИсходныеДанные.Получить();
		ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("ДвоичныеДанные") Тогда
			Двоичные = ИсходныеДанные;
		КонецЕсли;
		
		Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда 
			Возврат ""; 
		КонецЕсли;

		// === БЛОК СЖАТИЯ УДАЛЕН, Т.К. ПЛАТФОРМА ЕГО НЕ ПОДДЕРЖИВАЕТ ===
		// На старой платформе мы не можем уменьшить размер картинки программно 
		// без внешних компонент. Отправляем оригинал.
		
		// Проверка на лимит Firebase (1 Мб на документ). 
		// Если картинка больше 700 Кб, Base64 будет около 1 Мб.
		// Лучше не отправлять её вообще, чем получить ошибку при записи.
		Если Двоичные.Размер() > 700000 Тогда
			Сообщить("Внимание: Картинка слишком большая (" + Окр(Двоичные.Размер()/1024) + " Кб) и не может быть сжата. Она пропущена.");
			Возврат "";
		КонецЕсли;

		// 2. Конвертация в Base64
		СтрокаБ64 = Base64Строка(Двоичные);
		СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ПС, "");
		СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ВК, "");
		
		Возврат СтрокаБ64;
		
	Исключение
		Сообщить("Ошибка конвертации картинки: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
КонецФункции    


