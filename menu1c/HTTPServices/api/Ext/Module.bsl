// =========================
// МЕТОД GET: ПОЛУЧЕНИЕ МЕНЮ
// =========================


Функция apiV1MenuPOST(Запрос)
	
	// 1. Читаем JSON
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		СтруктураДанных = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.УстановитьТелоИзСтроки("Ошибка JSON: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;
	
	// 2. Поиск товара по ИдентификаторСервера (т.к. это уникальный ключ из Flutter)
	UID_Mobile = СтруктураДанных.uid;
	
	СпрНоменклатура = Справочники.Номенклатура;
	НайденнаяСсылка = СпрНоменклатура.НайтиПоРеквизиту("ИдентификаторСервера", UID_Mobile);
	
	Если НайденнаяСсылка.Пустая() Тогда
		ОбъектТовар = СпрНоменклатура.СоздатьЭлемент();
		// Если это группа (папка)
		Если СтруктураДанных.is_folder = Истина Тогда
			ОбъектТовар = СпрНоменклатура.СоздатьГруппу();
		КонецЕсли;
		// Записываем UID, чтобы в следующий раз найти этот товар
		ОбъектТовар.ИдентификаторСервера = UID_Mobile; 
	Иначе
		ОбъектТовар = НайденнаяСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	// 3. Заполняем основные реквизиты
	ОбъектТовар.Наименование = СтруктураДанных.name;
	
	Попытка
		ОбъектТовар.Описание = СтруктураДанных.desc; // Твой реквизит "Описание"
	Исключение
	КонецПопытки;
	
	Если СтруктураДанных.is_folder = Ложь Тогда
		Попытка
			ОбъектТовар.Цена = Число(СтруктураДанных.price); // Твой реквизит "Цена"
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// 4. Родитель (Группа)
	// Ищем родителя тоже по ИдентификаторСервера
	Если ЗначениеЗаполнено(СтруктураДанных.parent) Тогда
		РодительСсылка = СпрНоменклатура.НайтиПоРеквизиту("ИдентификаторСервера", СтруктураДанных.parent);
		Если Не РодительСсылка.Пустая() Тогда
			ОбъектТовар.Родитель = РодительСсылка;
		КонецЕсли;
	Иначе
		// Если родитель пустой, кидаем в корень (очищаем родителя)
		ОбъектТовар.Родитель = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	// 5. КАРТИНКА (Сохраняем в реквизит "Фото")
	Если ЗначениеЗаполнено(СтруктураДанных.image) Тогда
		Попытка
			Двоичные = Base64Значение(СтруктураДанных.image);
			ОбъектТовар.Фото = Новый ХранилищеЗначения(Двоичные);
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 6. ПОРЦИИ (Табличная часть)
	// Только если это не группа
	Если СтруктураДанных.is_folder = Ложь И СтруктураДанных.Свойство("portions") Тогда
		
		// Очищаем старые порции перед записью новых
		ОбъектТовар.Порции.Очистить();
		
		МассивПорций = СтруктураДанных.portions;
		Для Каждого СтрокаПорции Из МассивПорций Цикл
			НоваяСтрока = ОбъектТовар.Порции.Добавить();
			НоваяСтрока.Наименование = СтрокаПорции.name;
			НоваяСтрока.Цена = Число(СтрокаПорции.price);
		КонецЦикла;
		
	КонецЕсли;

	// 7. ЗАПИСЬ
	Попытка
		ОбъектТовар.Записать();
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.УстановитьТелоИзСтроки("Ошибка записи: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки("OK");
	Возврат Ответ;

КонецФункции


Функция V1MenuGET(Запрос)
	
	Попытка
		ОтветСтруктура = Новый Структура;
		
		// ПРОВЕРЯЕМ РЕЖИМ "LITE" (Только текст, без картинок)
		ТолькоТекст = (Запрос.ПараметрыЗапроса.Получить("lite") = "1");
		
		Запрос1С = Новый Запрос;
		Запрос1С.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка,
			|	Номенклатура.Родитель КАК Родитель,
			|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
			|	Номенклатура.Наименование КАК Наименование,
			|	ЕСТЬNULL(Номенклатура.Цена, 0) КАК Цена,
			|	ЕСТЬNULL(Номенклатура.Описание, """") КАК Описание,
			|	Номенклатура.Фото КАК Фото
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	НЕ Номенклатура.ПометкаУдаления";
			
		Выборка = Запрос1С.Выполнить().Выбрать();
		МассивТоваров = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("uid", XMLСтрока(Выборка.Ссылка));
			СтруктураТовара.Вставить("parent", ?(ЗначениеЗаполнено(Выборка.Родитель), XMLСтрока(Выборка.Родитель), ""));
			СтруктураТовара.Вставить("name", Выборка.Наименование);
			СтруктураТовара.Вставить("desc", Выборка.Описание);
			СтруктураТовара.Вставить("price", Выборка.Цена);
			СтруктураТовара.Вставить("is_folder", Выборка.ЭтоГруппа);
			
			// Изображения теперь грузятся отдельно по ссылке /image/{uid}
			СтруктураТовара.Вставить("image", "");
			
			// Порции
			МассивПорций = Новый Массив;
			Если НЕ Выборка.ЭтоГруппа Тогда
				Попытка
					ТЧ = Выборка.Ссылка.Порции; 
					Для Каждого СтрТЧ Из ТЧ Цикл
						МассивПорций.Добавить(Новый Структура("name, price", СтрТЧ.Наименование, СтрТЧ.Цена));
					КонецЦикла;
				Исключение КонецПопытки;
			КонецЕсли;
			СтруктураТовара.Вставить("portions", МассивПорций);
			
			МассивТоваров.Добавить(СтруктураТовара);
		КонецЦикла;
		
		// Данные организации (текст)
		ИмяМагазина = Строка(Константы.ИмяОрганизации.Получить());
		Слоган      = Строка(Константы.Слоган.Получить());
		Телефон     = Строка(Константы.НомерТелефона.Получить());
		
		Если ПустаяСтрока(ИмяМагазина) Тогда ИмяМагазина = "CAFE ANDALUS"; КонецЕсли;

		СтруктураОтвета = Новый Структура;
		// Логотип и QR теперь тянутся по отдельным ссылкам /image/logo и /image/qr
		СтруктураОтвета.Вставить("shop_logo", "");
		СтруктураОтвета.Вставить("shop_qr", "");
		СтруктураОтвета.Вставить("shop_name", ИмяМагазина);
		СтруктураОтвета.Вставить("shop_slogan", Слоган);
		СтруктураОтвета.Вставить("shop_phone", Телефон);
		СтруктураОтвета.Вставить("menu", МассивТоваров);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
		СтрокаОтвета = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки(СтрокаОтвета);
		Возврат Ответ;
		
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.УстановитьТелоИзСтроки("ОШИБКА 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;

КонецФункции

// =========================
// МЕТОД GET: ПОЛУЧЕНИЕ КАРТИНКИ (БИНАРНИКА)
// =========================
Функция V1ImageGET(Запрос)
	Попытка
		UID = Запрос.ПараметрыURL.Получить("uid");
		Двоичные = Неопределено;

		Если UID = "logo" Тогда
			Хранилище = Константы.ЛоготипОрганизации.Получить();
			Если ЗначениеЗаполнено(Хранилище) Тогда Двоичные = Хранилище.Получить(); КонецЕсли;
		ИначеЕсли UID = "qr" Тогда
			Хранилище = Константы.QRИнстаграма.Получить();
			Если ЗначениеЗаполнено(Хранилище) Тогда Двоичные = Хранилище.Получить(); КонецЕсли;
		Иначе
			СсылкаНоменклатуры = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(UID));
			Если ЗначениеЗаполнено(СсылкаНоменклатуры) И ЗначениеЗаполнено(СсылкаНоменклатуры.Фото) Тогда
				Двоичные = СсылкаНоменклатуры.Фото.Получить();
			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(Двоичные) = Тип("ДвоичныеДанные") Тогда
			Ответ = Новый HTTPСервисОтвет(200);
			Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
			Ответ.Заголовки.Вставить("Content-Type", "image/jpeg");
			// Кеширование в браузере на 1 сутки
			Ответ.Заголовки.Вставить("Cache-Control", "public, max-age=86400");
			Ответ.УстановитьТелоИзДвоичныхДанных(Двоичные);
			Возврат Ответ;
		Иначе
			// Нет картинки
			Ответ = Новый HTTPСервисОтвет(404);
			Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
			Ответ.УстановитьТелоИзСтроки("Image not found");
			Возврат Ответ;
		КонецЕсли;
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.УстановитьТелоИзСтроки("Error: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;
КонецФункции

// --- ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ДЛЯ МИНИАТЮР ---
Функция ПолучитьМИНИИзображениеBase64(ИсходныеДанные)
	Попытка
		Двоичные = Неопределено;
		Если ТипЗнч(ИсходныеДанные) = Тип("ХранилищеЗначения") Тогда
			Двоичные = ИсходныеДанные.Получить();
		ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("ДвоичныеДанные") Тогда
			Двоичные = ИсходныеДанные;
		КонецЕсли;
		
		Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда Возврат ""; КонецЕсли;

		// Сжимаем картинку до размеров миниатюры (например, 150х150)
		Картинка = Новый Картинка(Двоичные);
		Обработка = Новый ОбрабатываемаяКартинка(Картинка);
		Обработка.УстановитьРазмер(150, 150);
		НоваяКартинка = Обработка.ПолучитьКартинку();
		
		ДвоичныеМини = НоваяКартинка.ПолучитьДвоичныеДанные();

		// УСКОРЕНИЕ: пробуем самый быстрый метод платформы 8.3.14+
		Попытка
			Возврат ПолучитьBase64СтрокуИзДвоичныхДанных(ДвоичныеМини);
		Исключение
			СтрокаБ64 = Base64Строка(ДвоичныеМини);
			СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ПС, "");
			СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ВК, "");
			Возврат СтрокаБ64;
		КонецПопытки;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// --- ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ДЛЯ ПОЛНЫХ ФОТО ---
Функция ПолучитьСжатоеИзображениеBase64(ИсходныеДанные)
	Попытка
		Двоичные = Неопределено;
		Если ТипЗнч(ИсходныеДанные) = Тип("ХранилищеЗначения") Тогда
			Двоичные = ИсходныеДанные.Получить();
		ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("ДвоичныеДанные") Тогда
			Двоичные = ИсходныеДанные;
		КонецЕсли;
		
		Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда Возврат ""; КонецЕсли;

		// УСКОРЕНИЕ: пробуем самый быстрый метод платформы 8.3.14+
		Попытка
			Возврат ПолучитьBase64СтрокуИзДвоичныхДанных(Двоичные);
		Исключение
			СтрокаБ64 = Base64Строка(Двоичные);
			СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ПС, "");
			СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ВК, "");
			Возврат СтрокаБ64;
		КонецПопытки;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции  



