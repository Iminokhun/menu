&НаКлиенте
Процедура СобратьФайлыВЕдиныйДокумент(Команда)
	
	// 1. Выбираем папку, где лежат ваши папки и XML
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите корневую папку с выгрузкой (XML/BSL)";
	
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКПапке = Диалог.Каталог;
	
	// Имя итогового файла
	ПутьКФайлуРезультату = ПутьКПапке + "\ALL_CONFIG_IN_ONE.txt";
	
	// 2. Открываем запись текста (потоковая запись, чтобы не грузить память)
	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлуРезультату, КодировкаТекста.UTF8);
	
	// Пишем заголовок для ИИ
	ЗаписьТекста.ЗаписатьСтроку("CONTEXT: 1C Configuration Dump");
	ЗаписьТекста.ЗаписатьСтроку("This file contains merged content of XML and BSL files from the configuration.");
	ЗаписьТекста.ЗаписатьСтроку("================================================================================");
	
	// 3. Ищем файлы (ИСТИНА в третьем параметре включает поиск в подпапках)
	МассивФайлов = НайтиФайлы(ПутьКПапке, "*.*", Истина);
	
	Счетчик = 0;
	
	Для Каждого Файл Из МассивФайлов Цикл
		
		Расширение = НРег(Файл.Расширение);
		
		// Фильтр: берем только .xml (метаданные) и .bsl (код 1С)
		// Если нужно собрать ВООБЩЕ всё, уберите это условие
		Если Расширение = ".xml" ИЛИ Расширение = ".bsl" Тогда
			
			// Пропускаем сам файл-результат, если он создался внутри той же папки
			Если Файл.ПолноеИмя = ПутьКФайлуРезультату Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				// Читаем текущий файл
				Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
				Содержимое = Чтение.Прочитать();
				Чтение.Закрыть();
				
				// Если файл не пустой
				Если ЗначениеЗаполнено(Содержимое) Тогда
					
					// Формируем заголовок файла для ИИ, чтобы он понимал структуру папок
					ЗаписьТекста.ЗаписатьСтроку(""); 
					ЗаписьТекста.ЗаписатьСтроку("vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv");
					ЗаписьТекста.ЗаписатьСтроку("FILE_PATH: " + СтрЗаменить(Файл.ПолноеИмя, ПутьКПапке, "")); // Относительный путь
					ЗаписьТекста.ЗаписатьСтроку("FILE_NAME: " + Файл.Имя);
					ЗаписьТекста.ЗаписатьСтроку("^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^");
					
					// Записываем содержимое
					ЗаписьТекста.ЗаписатьСтроку(Содержимое);
					
					Счетчик = Счетчик + 1;
				КонецЕсли;
				
			Исключение
				Сообщить("Не удалось прочитать файл: " + Файл.Имя + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписьТекста.Закрыть();
	
	Сообщить("Готово! Обработано файлов: " + Счетчик);
	Сообщить("Результат здесь: " + ПутьКФайлуРезультату);
	
КонецПроцедуры   


&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Проверка: нельзя грузить фото для папок или если ничего не выбрано
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите товар (не папку)!");
		Возврат;
	КонецЕсли;
	
	ЗагрузитьФотоДляСписка(ТекущиеДанные.Ссылка);
	
КонецПроцедуры



&НаКлиенте
Процедура ЗагрузитьФотоДляСписка(СсылкаНаТовар)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаВПиске", ЭтотОбъект, СсылкаНаТовар);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Картинки|*.jpg;*.jpeg;*.png";
	
	НачатьПомещениеФайла(Оповещение, , Диалог, Истина, УникальныйИдентификатор);

КонецПроцедуры   

&НаКлиенте
Процедура ПослеВыбораФайлаВПиске(Результат, Адрес, ВыбранноеИмя, СсылкаНаТовар) Экспорт
	
	Если Результат Тогда
		// Обновляем картинку на экране сразу
		АдресКартинки = Адрес;
		
		// Сохраняем в базу
		СохранитьФотоТовараНаСервере(СсылкаНаТовар, Адрес);
		
		ПоказатьОповещениеПользователя("Фото сохранено!");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьФотоТовараНаСервере(СсылкаНаТовар, АдресВХранилище)
	
	// Получаем объект, чтобы записать фото
	ТоварОбъект = СсылкаНаТовар.ПолучитьОбъект();
	Двоичные = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ТоварОбъект.Фото = Новый ХранилищеЗначения(Двоичные);
	ТоварОбъект.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦены(Команда)
	ИзменитьЦеныНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИзменитьЦеныНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Цена > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		Товар = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		
		// 1. Вычисляем новую цену (-4%)
		НоваяЦена = Товар.Цена * 0.96; 
		// 2. Округляем до ближайших 5
		Товар.Цена = Окр(НоваяЦена / 10, 0) * 10;
		
		Для каждого Стр ИЗ Товар.Порции Цикл
			// То же самое для табличной части
			НоваяЦенаСтр = Стр.Цена * 0.96;
			Стр.Цена = Окр(НоваяЦенаСтр / 10, 0) * 10;
		КонецЦикла;
		
		Товар.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

