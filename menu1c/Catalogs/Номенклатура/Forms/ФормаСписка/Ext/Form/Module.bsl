                                       &НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// Получаем текущую строку (ссылку на товар)
	ТекущаяСсылка = Элементы.Список.ТекущаяСтрока;
	
	Если ЗначениеЗаполнено(ТекущаяСсылка) Тогда
		// 1С умеет сама получать ссылку на картинку без лишних запросов
		АдресКартинки = ПолучитьНавигационнуюСсылку(ТекущаяСсылка, "Фото");
	Иначе
		АдресКартинки = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокТоваровНаСервере()
	
	// Адаптировано под твой справочник "Товары"
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления"; 
		
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервере
Процедура ВыгрузитьПорциюНаСервере(МассивСсылок, Ошибка)
	
	// !!! ПРОВЕРЬ ID ПРОЕКТА !!!
	IDПроекта  = "andalus-menu-63f23"; 
	
	Соединение = Новый HTTPСоединение("firestore.googleapis.com", 443, , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	// Запрос адаптирован: берем данные из справочника Товары + Картинка + Порции
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
		|	Номенклатура.Родитель КАК Родитель,
		|	ЕСТЬNULL(Номенклатура.Цена, 0) КАК Цена,
		|	ЕСТЬNULL(Номенклатура.Описание, """") КАК Описание,
		|	Номенклатура.Фото КАК Фото
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В (&МассивСсылок)";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		// 1. Подготовка ID
		СтрокаID = XMLСтрока(Выборка.Ссылка); 
		РодительID = ?(ЗначениеЗаполнено(Выборка.Родитель), XMLСтрока(Выборка.Родитель), "");
		
		// 2. Картинка (Base64)
		СтрокаBase64 = ПолучитьСжатоеИзображениеBase64(Выборка.Фото);

		// 3. Порции (Превращаем их в batches для совместимости с Vendor App)
		МассивПорций = Новый Массив;
		Если НЕ Выборка.ЭтоГруппа Тогда
			
			// Если есть ТЧ "Порции", берем оттуда
			Попытка
				ТЧ = Выборка.Ссылка.Порции;
				Для Каждого СтрТЧ Из ТЧ Цикл
					Batch = Новый Структура;
					Batch.Вставить("name",        Новый Структура("stringValue", СтрТЧ.Наименование));
					Batch.Вставить("price",       Новый Структура("doubleValue", СтрТЧ.Цена));
					Batch.Вставить("stock_qty",   Новый Структура("integerValue", 999)); // Заглушка остатка
					
					МассивПорций.Добавить(Новый Структура("mapValue", Новый Структура("fields", Batch)));
				КонецЦикла;
			Исключение
			КонецПопытки;
			
			// Если порций нет, добавляем одну "Основную" партию (сам товар)
			Если МассивПорций.Количество() = 0 Тогда
				Batch = Новый Структура;
				Batch.Вставить("name",        Новый Структура("stringValue", "Основная"));
				Batch.Вставить("price",       Новый Структура("doubleValue", Выборка.Цена));
				Batch.Вставить("stock_qty",   Новый Структура("integerValue", 999));
				МассивПорций.Добавить(Новый Структура("mapValue", Новый Структура("fields", Batch)));
			КонецЕсли;
			
		КонецЕсли;

		// 4. СБОР JSON
		СтруктураПолей = Новый Структура;
		СтруктураПолей.Вставить("uid",         Новый Структура("stringValue", СтрокаID)); // Важно для Flutter
		СтруктураПолей.Вставить("name",        Новый Структура("stringValue", СокрЛП(Выборка.Наименование)));
		СтруктураПолей.Вставить("desc",        Новый Структура("stringValue", СокрЛП(Выборка.Описание)));
		//СтруктураПолей.Вставить("sku",         Новый Структура("stringValue", СокрЛП(Выборка.Артикул)));
		СтруктураПолей.Вставить("is_folder",   Новый Структура("booleanValue", Выборка.ЭтоГруппа));
		СтруктураПолей.Вставить("parent",      Новый Структура("stringValue", РодительID));
		
		СтруктураПолей.Вставить("price",       Новый Структура("doubleValue",  Выборка.Цена)); 
		СтруктураПолей.Вставить("image",       Новый Структура("stringValue", СтрокаBase64)); 

		// Вставляем порции как batches (для совместимости) и как portions (для меню)
		СтруктураПолей.Вставить("portions",    Новый Структура("arrayValue", Новый Структура("values", МассивПорций)));
		СтруктураПолей.Вставить("batches",     Новый Структура("arrayValue", Новый Структура("values", МассивПорций)));

		JSONСтруктура = Новый Структура("fields", СтруктураПолей);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, JSONСтруктура);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		// 5. ОТПРАВКА (PATCH обновляет документ или создает, если нет)
		АдресРесурса = "/v1/projects/" + IDПроекта + "/databases/(default)/documents/products/" + СтрокаID;
		ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса);
		ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json");
		ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		
		Попытка
			Соединение.ВызватьHTTPМетод("PATCH", ЗапросHTTP);
		Исключение
			Ошибка = ОписаниеОшибки();
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

