&НаКлиенте
Процедура Выгрузить(Команда)
	
	// 1. Получаем список ВСЕХ товаров (только Ссылки)
	МассивВсехТоваров = ПолучитьСписокТоваровНаСервере();
	
	ОбщееКоличество = МассивВсехТоваров.Количество();
	Если ОбщееКоличество = 0 Тогда
		Сообщить("Нет товаров для выгрузки!");
		Возврат;
	КонецЕсли;
	
	// Настройки порций
	РазмерПорции = 20; // Выгружаем по 20 товаров за раз
	ТекущаяПозиция = 0;
	
	// 2. Запускаем цикл по порциям
	Пока ТекущаяПозиция < ОбщееКоличество Цикл
		
		МассивПорции = Новый Массив;
		Для Сч = 0 По РазмерПорции - 1 Цикл
			Индекс = ТекущаяПозиция + Сч;
			Если Индекс >= ОбщееКоличество Тогда Прервать; КонецЕсли;
			МассивПорции.Добавить(МассивВсехТоваров[Индекс]);
		КонецЦикла;
		
		// 3. Отправляем пачку
		Ошибка = "";
		ВыгрузитьПорциюНаСервере(МассивПорции, Ошибка);
		
		Если ЗначениеЗаполнено(Ошибка) Тогда
			Сообщить("Сбой на позиции " + ТекущаяПозиция + ": " + Ошибка);
		КонецЕсли;
		
		// 4. Обновляем Прогресс
		ТекущаяПозиция = ТекущаяПозиция + МассивПорции.Количество();
		Процент = Окр((ТекущаяПозиция / ОбщееКоличество) * 100);
		
		Состояние("Выгрузка товаров: " + Процент + "% (" + ТекущаяПозиция + " из " + ОбщееКоличество + ")", Процент);
		ОбработкаПрерыванияПользователя(); 
		
	КонецЦикла;
	
	Состояние("Готово!");
	Сообщить("✅ Полная выгрузка завершена! Всего товаров: " + ОбщееКоличество);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	ОчиститьБазуFirebaseНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПоставщиков(Команда)
	ВыгрузитьПоставщиковНаСервере();
КонецПроцедуры


