// ВЫГРУЗКА ПОСТАВЩИКОВ (АДАПТИРОВАНО)
// ==========================================
&НаСервере
Процедура ВыгрузитьПоставщиковНаСервере()
	
	IDПроекта = "andalus-menu-63f23"; // Твой ID
	Соединение = Новый HTTPСоединение("firestore.googleapis.com", 443, , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	// Используем стандартный справочник Контрагенты
	// ПРОВЕРЬ: Есть ли у тебя реквизит "Поставщик"? Если нет - убери условие.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления";
		// |	И Контрагенты.Поставщик = ИСТИНА"; // Раскомментируй, если есть галочка "Поставщик"
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Генерируем простой логин (admin + последние 4 цифры ID)
		VendorID = XMLСтрока(Выборка.Ссылка);
		Login = "vendor" + Прав(СтрЗаменить(VendorID, "-", ""), 4);
		
		СтруктураПолей = Новый Структура;
		СтруктураПолей.Вставить("id",       Новый Структура("stringValue", VendorID));
		СтруктураПолей.Вставить("name",     Новый Структура("stringValue", СокрЛП(Выборка.Наименование)));
		СтруктураПолей.Вставить("login",    Новый Структура("stringValue", Login));
		СтруктураПолей.Вставить("password", Новый Структура("stringValue", "123456"));
		СтруктураПолей.Вставить("role",     Новый Структура("stringValue", "vendor"));

		JSONСтруктура = Новый Структура("fields", СтруктураПолей);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, JSONСтруктура);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		АдресРесурса = "/v1/projects/" + IDПроекта + "/databases/(default)/documents/vendors/" + VendorID;
		ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса);
		ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json");
		ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		
		Попытка
			Соединение.ВызватьHTTPМетод("PATCH", ЗапросHTTP);
			Сообщить("Вендор: " + Выборка.Наименование + " | Логин: " + Login);
		Исключение
		КонецПопытки;

	КонецЦикла;
	
	Сообщить("✅ Поставщики выгружены!");

КонецПроцедуры 

