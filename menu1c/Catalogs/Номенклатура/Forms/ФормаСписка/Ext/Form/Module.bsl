&НаСервере
Процедура УдалитьВсеВКоллекции(Соединение, IDПроекта, ИмяКоллекции)
	Пока Истина Цикл
		АдресСписка = "/v1/projects/" + IDПроекта + "/databases/(default)/documents/" + ИмяКоллекции + "?pageSize=100";
		ЗапросHTTP = Новый HTTPЗапрос(АдресСписка);
		Попытка
			Ответ = Соединение.ВызватьHTTPМетод("GET", ЗапросHTTP);
		Исключение
			Прервать;
		КонецПопытки;
		
		Если Ответ.КодСостояния <> 200 Тогда Прервать; КонецЕсли;
		
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		
		Попытка МассивДоков = Данные.documents; Исключение Прервать; КонецПопытки;
		Если МассивДоков = Неопределено ИЛИ МассивДоков.Количество() = 0 Тогда Прервать; КонецЕсли;
		
		Для Каждого ДокСтруктура Из МассивДоков Цикл
			ПолныйПуть = ДокСтруктура.name;
			МассивЧастей = СтрРазделить(ПолныйПуть, "/");
			ДокID = МассивЧастей[МассивЧастей.ВГраница()];
			АдресУдаления = "/v1/projects/" + IDПроекта + "/databases/(default)/documents/" + ИмяКоллекции + "/" + ДокID;
			Соединение.ВызватьHTTPМетод("DELETE", Новый HTTPЗапрос(АдресУдаления));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Вспомогательная функция для картинок



&НаСервере
Функция ПолучитьСжатоеИзображениеBase64(ИсходныеДанные)
	
	Попытка
		Двоичные = Неопределено;
		
		// 1. Извлекаем двоичные данные
		Если ТипЗнч(ИсходныеДанные) = Тип("ХранилищеЗначения") Тогда
			Двоичные = ИсходныеДанные.Получить();
		ИначеЕсли ТипЗнч(ИсходныеДанные) = Тип("ДвоичныеДанные") Тогда
			Двоичные = ИсходныеДанные;
		КонецЕсли;
		
		Если ТипЗнч(Двоичные) <> Тип("ДвоичныеДанные") Тогда 
			Возврат ""; 
		КонецЕсли;

		// === БЛОК СЖАТИЯ УДАЛЕН, Т.К. ПЛАТФОРМА ЕГО НЕ ПОДДЕРЖИВАЕТ ===
		// На старой платформе мы не можем уменьшить размер картинки программно 
		// без внешних компонент. Отправляем оригинал.
		
		// Проверка на лимит Firebase (1 Мб на документ). 
		// Если картинка больше 700 Кб, Base64 будет около 1 Мб.
		// Лучше не отправлять её вообще, чем получить ошибку при записи.
		Если Двоичные.Размер() > 700000 Тогда
			Сообщить("Внимание: Картинка слишком большая (" + Окр(Двоичные.Размер()/1024) + " Кб) и не может быть сжата. Она пропущена.");
			Возврат "";
		КонецЕсли;

		// 2. Конвертация в Base64
		СтрокаБ64 = Base64Строка(Двоичные);
		СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ПС, "");
		СтрокаБ64 = СтрЗаменить(СтрокаБ64, Символы.ВК, "");
		
		Возврат СтрокаБ64;
		
	Исключение
		Сообщить("Ошибка конвертации картинки: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
КонецФункции    

