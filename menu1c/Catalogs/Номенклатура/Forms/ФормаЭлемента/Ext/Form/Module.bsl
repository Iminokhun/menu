&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// При открытии карточки показываем текущую картинку
	// Используем стандартный механизм навигационных ссылок 1С
	АдресКартинки = ПолучитьНавигационнуюСсылку(Объект.Ссылка, "Фото");
КонецПроцедуры

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь; // Отключаем стандартный клик
	ЗагрузитьНовоеФото();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНовоеФото()
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	
	// Настройки диалога выбора
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите фото товара";
	Диалог.Фильтр = "Картинки (*.jpg;*.png)|*.jpg;*.jpeg;*.png";
	Диалог.МножественныйВыбор = Ложь;
	
	// Начинаем загрузку (асинхронно)
	НачатьПомещениеФайла(Оповещение, , Диалог, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		// 1. Показываем картинку на форме сразу (чтобы админ видел результат)
		АдресКартинки = Адрес;
		Модифицированность = Истина;
		
		// 2. Сразу сохраняем её в базу (чтобы не нажимать "Записать" лишний раз)
		СохранитьФотоНаСервере(Адрес);
		
		ПоказатьОповещениеПользователя("Фото обновлено!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьФотоНаСервере(ВременныйАдрес)
	
	// Превращаем реквизит формы в реальный объект Справочника
	ТекущийТовар = РеквизитФормыВЗначение("Объект");
	
	// Получаем файл из временного хранилища
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ВременныйАдрес);
	
	// Записываем в реквизит "Фото" (ХранилищеЗначения)
	ТекущийТовар.Фото = Новый ХранилищеЗначения(ДвоичныеДанные);
	
	// Сохраняем объект
	ТекущийТовар.Записать();
	
	// Обновляем форму, чтобы она знала, что объект сохранен
	ЗначениеВРеквизитФормы(ТекущийТовар, "Объект");
	
КонецПроцедуры

