# Скопируйте в .env и заполните:  cp .env.example .env

# Домен меню. DNS-запись A (и www) должна указывать на IP этого сервера
DOMAIN=menu.kg

# Адрес меню для гостей — из него собираются ссылки QR-кодов.
# Должен совпадать с доменом
MENU_URL=https://menu.kg
PUBLIC_URL=https://menu.kg

# Кому платить за меню — кафе видит это, когда срок подходит к концу
BILLING_CONTACT=WhatsApp +996 000 000 000

# Место на диске для фото и 3D-моделей одного кафе, МБ
UPLOAD_QUOTA_MB=2048

# Как меню выходит в интернет:
# - на сервере уже есть nginx другого проекта — оставьте как есть: тот
#   nginx достаёт до меню по общей сети edge (nginx-menu.conf);
# - сервер только для меню — раскомментируйте, HTTPS сделает свой Caddy:
# COMPOSE_PROFILES=caddy

# Метка версии образа: ставьте дату обновления, чтобы можно было откатиться
MENU_VERSION=latest
